{
  "name": "@sierrasoftworks/actions-tap",
  "version": "0.0.0",
  "private": true,
  "description": "Publishes Homebrew formulae to the Sierra Softworks tap.",
  "type": "module",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "tsc -p tsconfig.test.json && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx rollup --config rollup.config.js",
    "package:watch": "npm run package -- --watch",
    "test": "tsc -p tsconfig.test.json && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SierraSoftworks/actions-tap.git"
  },
  "keywords": [
    "actions",
    "github",
    "homebrew",
    "tap"
  ],
  "author": "Benjamin Pannell <admin@sierrasoftworks.com>",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/auth-app": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.5",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
